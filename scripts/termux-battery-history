#!/data/data/com.termux/files/usr/bin/sh
# termux-battery-history — fork Spartan117x/termux-api (v0.53.0-spartan117x.2)
# Guarda una muestra de la batería y muestra el historial completo en JSON.
# Uso: termux-battery-history
# Para llenar el historial solo, llámalo desde un cron cada 5 minutos:
#   */5 * * * * termux-battery-history > /dev/null
# Requiere la app "Termux API Spartan117x" instalada.
termux-api BatteryHistory
